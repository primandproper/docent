      "file": "api/internal/http/items.go",
      "pattern": "^func \\(h \\*Handler\\) GetItem",
      "line": 15,
      "description": "The page layout is a JSON flag, and only a pilot segment gets the new one.",
      "links": [
        { "kind": "flag", "title": "One-page checkout", "flag": "one-page-checkout" }
      ]
    },
    {
      "id": "many",
      "title": "Six rules deep",
      "file": "api/internal/http/items.go",
